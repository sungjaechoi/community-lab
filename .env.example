# Copy to .env.local in the app root. Never commit real values.
# See docs/supabase-setup.md. Keep values empty until selected in Dashboard.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Connect > Transaction pooler. URI-encode reserved password characters.
DATABASE_URL=
# Connect > Direct connection; session is an IPv4 compatibility alternative.
MIGRATION_DATABASE_URL=
MIGRATION_DATABASE_CONNECTION_MODE=direct
# Optional trusted root certificate downloaded from Database settings.
# Use only if the system trust store cannot validate the server certificate.
DATABASE_CA_CERT_PATH=
MIGRATION_DATABASE_CA_CERT_PATH=
