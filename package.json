{
  "name": "community-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "env:check": "tsx scripts/check-db.ts --env-only",
    "db:check": "tsx scripts/check-db.ts",
    "test:setup": "tsx --test src/lib/database/config.test.ts",
    "env:configure": "node scripts/configure-db-password.mjs",
    "test:env:check": "NODE_ENV=test tsx scripts/check-test-environment.ts",
    "test:env:start": "tsx scripts/manage-test-environment.ts start",
    "test:env:stop": "tsx scripts/manage-test-environment.ts stop",
    "test:env:sync": "tsx scripts/manage-test-environment.ts sync"
  },
  "dependencies": {
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@next/env": "16.4.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.15.1",
    "pnpm": ">=10 <11"
  }
}
