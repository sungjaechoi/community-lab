{
  "name": "community-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TRACE_SPAN_THRESHOLD_MS=9007199254740991 next dev",
    "build": "next build",
    "start": "NEXT_TRACE_SPAN_THRESHOLD_MS=9007199254740991 next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "env:check": "tsx scripts/check-db.ts --env-only",
    "db:check": "tsx scripts/check-db.ts",
    "env:configure": "node scripts/configure-db-password.mjs",
    "db:config:check": "COMMUNITY_LAB_DB_ENV=development tsx scripts/database-tool.ts config",
    "db:generate": "COMMUNITY_LAB_DB_ENV=development tsx scripts/database-tool.ts generate",
    "db:migrations:check": "COMMUNITY_LAB_DB_ENV=development tsx scripts/database-tool.ts check",
    "db:migrate": "COMMUNITY_LAB_DB_ENV=development tsx scripts/database-tool.ts migrate"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@next/env": "16.4.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.15.1",
    "pnpm": ">=10 <11"
  }
}
